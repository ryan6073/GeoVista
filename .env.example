# ==========================================
# 📂 Directory Configuration (目录配置)
# ==========================================
# Benchmark 数据集的根目录
BENCHMARK_ROOT=/srv/user/zhujs/benchmark
# 结果保存的工作目录
WORK_DIR=/srv/user/GeoVista-7B-Preview/result

# ==========================================
# 🚀 API Configuration (模型服务配置)
# ==========================================
# API 基础地址 (支持 vLLM 本地端口 或 OpenAI 兼容的中转站)
# vLLM 示例: http://localhost:8000/v1
# 中转站示例: https://api.deepseek.com/v1 或 https://api.openai.com/v1
API_BASE=http://localhost:8000/v1

# API 密钥 (vLLM 可填 empty；中转站请填写真实的 sk-... Token)
API_KEY=empty